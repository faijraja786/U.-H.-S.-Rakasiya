rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/roles/$(request.auth.uid)
        ).data.role in ['admin', 'superadmin'];
    }

    match /learning/{path=**} {
      allow read: if signedIn();

      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
