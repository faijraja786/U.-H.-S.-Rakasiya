rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/roles/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn()
        && userRole() in ['admin', 'superadmin'];
    }

    // USER ROLES
    match /roles/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow write: if false;
    }

    // QUIZZES
    match /quizzes/{quizId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.status == 'published');

      allow write: if false;

      // PUBLIC QUESTIONS
      match /publicQuestions/{questionId} {
        allow read: if signedIn()
          && (
            isAdmin()
            || get(
              /databases/$(database)/documents/quizzes/$(quizId)
            ).data.status == 'published'
          );

        allow write: if false;
      }

      // PRIVATE ANSWERS
      match /privateAnswers/{questionId} {
        allow read, write: if isAdmin();
      }

      // QUIZ ATTEMPTS
      match /attempts/{attemptId} {
        allow read: if signedIn()
          && (
            isAdmin()
            || resource.data.uid == request.auth.uid
          );

        allow write: if false;
      }

      // LEADERBOARD
      match /leaderboard/{uid} {
        allow read: if signedIn() && isAdmin();

        allow write: if false;
      }
    }

    // STUDENT DATA
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    // LEARNING CONTENT
    match /content/{contentId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.published == true
        );

      allow write: if false;
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
