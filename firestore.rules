rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/roles/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn()
        && userRole() in ['admin', 'superadmin'];
    }

    function studentClassMatchesQuiz(quiz) {
      let quizClass = quiz.get('className', '');
      let rolePath = /databases/$(database)/documents/roles/$(request.auth.uid);
      return exists(rolePath)
        && (
          quizClass == ''
          || quizClass in ['all', 'All', 'general', 'General', 'सभी']
          || quizClass == get(rolePath).data.get('className', '')
        );
    }

    function canReadQuizQuestions(quizId) {
      let quiz = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
      return signedIn()
        && (
          isAdmin()
          || (quiz.status == 'published' && studentClassMatchesQuiz(quiz))
        );
    }

    // USER ROLES
    match /roles/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow write: if false;
    }

    // QUIZZES
    match /quizzes/{quizId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.status == 'published');

      allow write: if false;

      // PUBLIC QUESTIONS
      match /publicQuestions/{questionId} {
        // A student may read questions only for their own class (or general quizzes).
        allow read: if canReadQuizQuestions(quizId);
        allow write: if false;
      }

      // PRIVATE ANSWERS
      match /privateAnswers/{questionId} {
        allow read, write: if isAdmin();
      }

      // QUIZ ATTEMPTS
      match /attempts/{attemptId} {
        // Allow reading the student's own attempt even before it exists.
        allow read: if signedIn()
          && (
            isAdmin()
            || attemptId == request.auth.uid
            || resource.data.uid == request.auth.uid
          );

        allow write: if false;
      }

      // LEADERBOARD
      match /leaderboard/{uid} {
        allow read: if signedIn() && isAdmin();

        allow write: if false;
      }
    }

    // STUDENT DATA
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    // LEARNING CONTENT
    match /content/{contentId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.published == true
        );

      allow write: if false;
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
